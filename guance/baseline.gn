# Public Chromium release baseline; do not import build/args/headless.gn.
# Pinned to Chromium 156.0.8078.47, Linux x64.
is_official_build = true
is_debug = false
is_component_build = false
target_os = "linux"
target_cpu = "x64"
symbol_level = 0

# Match the public CfT flavor and codec configuration. Internal branding assets
# are unavailable in the public source archive.
is_chrome_for_testing = true
is_chrome_for_testing_branded = false
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# Pin release optimization settings; leave all Shell features at their defaults.
dcheck_always_on = false
enable_expensive_dchecks = false
chrome_pgo_phase = 2
use_thin_lto = true
optimize_for_size = false

# Local execution replaces Google's remote build infrastructure.
use_remoteexec = false
use_siso = false
